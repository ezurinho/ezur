# La nota de promoción viaja con el repo; el resto de data/research (ledger,
# artefactos, specs) sigue fuera. La cadena hace falta entera: git no entra en
# un directorio ignorado, así que negar solo el fichero no lo rescata.
!data/research/
data/research/*
!data/research/promotion/
data/research/promotion/*
!data/research/promotion/README.md
backups/
reports/backtest/*
!reports/backtest/.gitkeep
!reports/backtest/simulation-*.json
!reports/backtest/walkforward-*.json
reports/paper_breakdown_*
profiles/*/
!profiles/.gitkeep
!profiles/demo/
!profiles/demo/config.json
!profiles/okx/
!profiles/okx/config.json
profiles/*/run.log
profiles/*/terminal.lock
profiles/*/terminal.lock.owner
.superpowers/
*.db
*.db-wal
*.db-shm
# Empaquetado de escritorio: el venv de build y lo que producen PyInstaller e Inno.
.build/
dist_exe/
dist_installer/
*.spec.bak

# Investigación: datos de mercado y artefactos voluminosos no van al repo.
research_engine/research/cache/*.pkl
research_engine/research/cache/*.parquet
research_engine/app/registry.db

