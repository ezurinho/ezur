{
  "id": "BTC-TREND-4H",
  "name": "Donchian breakout 4h",
  "version": "1.0.0",
  "label": "4h_24",
  "family": "trend",
  "hypothesis": "Same persistence hypothesis as the daily Donchian, sampled at 4h: four times the resolves per year with the round-trip cost still at ~0.05 R, so the strategy trades more often without the cost dominating. If the edge is real at the order-flow horizon it should appear here with a shallower, more frequent exposure than on 1d.",
  "instrument": "BTCUSDT_PERP",
  "timeframe_signal": "4h",
  "timeframe_context": "1d",
  "data_requirements": {
    "datasets": ["klines_5m", "funding_rate"],
    "min_coverage": "2020-01-01/2026-10-31",
    "integrity": { "gaps": 0, "duplicates": 0, "timezone": "UTC" }
  },
  "entry": {
    "rule": "donchian_breakout",
    "long": "close[t] > max(high[t-N .. t-1])",
    "short": "close[t] < min(low[t-N .. t-1])",
    "cooldown_bars": 0
  },
  "exit": {
    "stop": "1.5 * ATR(14)[t]",
    "target": "4.0 * R",
    "time_stop_bars": 20,
    "trailing": null
  },
  "params": {
    "N": 24,
    "atr_k": 1.5,
    "tp_r": 4.0
  },
  "risk": {
    "sizing": "fixed_fractional",
    "risk_per_trade": 0.005,
    "target_vol_annual": 0.2,
    "kelly_fraction": 0.25,
    "max_gross_leverage": 2.0,
    "max_mdd_budget": 0.25
  },
  "costs": {
    "fee_maker_bps": 2.0,
    "fee_taker_bps": 5.0,
    "assumed_fill": "taker",
    "half_spread_bps": 0.07,
    "impact_model": "none",
    "funding": "real_timestamps"
  },
  "execution": {
    "signal_bar": "closed",
    "fill": "next_bar_open",
    "intrabar_priority": "stop_first",
    "gap_fill": "bar_open"
  },
  "validation": {
    "trials_declared": 8,
    "is_oos_split": "0.60/0.20/0.20",
    "seed": 7,
    "bootstrap": { "block": 5, "reps": 4000 },
    "wfa": { "train_years": 2, "test_months": 6, "min_trades_per_fold": 30 }
  },
  "expected": {
    "turnover_per_year": 77,
    "cost_R_per_trade": 0.05,
    "capacity_usd": 250000
  },
  "failure_modes": [
    "el IC del PF sigue siendo ancho con 524 trades: el Sharpe no alcanza significancia",
    "el funding (0,011 R) pesa menos que las fees pero no es despreciable en rachas largas",
    "en 4h el ruido de sesión (Asia/Europa/US) domina la ruptura de canal"
  ]
}
